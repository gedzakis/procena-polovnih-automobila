PORT=3000
JWT_SECRET=promeni-ovo-u-dugacak-random-string
ADMIN_KEY=promeni-ovo-za-rucno-pokretanje-scrapera

# Izvori: demo (simulirani podaci, radi odmah) i/ili polovni (pravi scraper, vidi README)
SOURCES=demo
# Kad pustiš sajt u rad sa pravim oglasima korisnika, ostavi prazno: SOURCES=
SCRAPE_CRON=*/30 * * * *
# Oglas se proglasi isteklim kada nestane iz N uzastopnih uspešnih prolaza
EXPIRE_AFTER_MISSES=2
# Istekli oglasi se trajno brišu (zajedno sa istorijom cena) posle N dana
PURGE_AFTER_DAYS=30

# Email (SMTP) - ako je prazno, poruke se samo ispisuju u konzolu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AutoExpert <alerts@tvoj-domen.rs>

# SMS preko Twilio-a (opciono)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Viber Bot (opciono) - korisnik mora prvo da se pretplati na vaš bot
VIBER_TOKEN=

PUBLIC_URL=http://localhost:3000

# Vlastiti oglasi
MAX_ACTIVE_USER_LISTINGS=10
USER_LISTING_DAYS=60
